# Compass AI configuration
# Copy this file to .env and fill in your own values. Never commit .env.

# Groq API key (required for LLM evaluation).
GROQ_API_KEY=

# Groq model identifier. Must be currently available to your account.
# Verified at startup; a stale or unavailable ID fails fast with a clear message.
GROQ_MODEL=

# Optional GitHub token (read-only). Raises limits from 60 to 5,000 req/hour.
# For public-only access, create a fine-grained token with Metadata/Contents/Issues read.
GITHUB_TOKEN=

# Target number of ranked issues to return (default 3).
COMPASS_TARGET_ISSUES=3

# Maximum issue pages to scan (default 3). Bounded; never unbounded.
COMPASS_MAX_PAGES=3

# Maximum concurrent evaluation workers when parallel mode is enabled (default 3).
COMPASS_MAX_CONCURRENCY=3

# HTTP request timeout in seconds (default 20).
COMPASS_REQUEST_TIMEOUT=20

# Maximum difficulty score allowed by the quality gate (default 3; 1=easiest, 5=hardest).
COMPASS_MAX_DIFFICULTY=3